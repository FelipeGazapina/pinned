<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime refuses the microphone, without a prompt, to an app that lacks this.
	     macOS checks it on the app, which it holds responsible for the dictation helper it starts. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
