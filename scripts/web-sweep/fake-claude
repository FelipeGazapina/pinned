#!/usr/bin/env node
// Stands in for `claude` on the sweep's node: it calls the same hooks and statusline that
// pinned's --settings file names, and prints every key it gets, so a test can read them back.
const { execFileSync } = require("child_process");
const fs = require("fs");
const path = require("path");

const args = process.argv.slice(2);
const settingsFile = args[args.indexOf("--settings") + 1];
const settings = settingsFile ? JSON.parse(fs.readFileSync(settingsFile, "utf8")) : {};
const session = `fake-${process.pid}`;

function run(command, input) {
  try {
    execFileSync("/bin/sh", ["-c", command], { input: JSON.stringify(input), stdio: ["pipe", "ignore", "ignore"] });
  } catch {}
}
const hook = (event, extra = {}) => {
  const command = settings.hooks?.[event]?.[0]?.hooks?.[0]?.command;
  if (command) run(command, { session_id: session, cwd: process.cwd(), ...extra });
};
// Claude Code's transcript, in the shape the GUI reads: one JSON object per line.
const transcript = path.join(process.env.HOME, ".claude", "projects", process.cwd().replace(/[^a-zA-Z0-9]/g, "-"), `${session}.jsonl`);
fs.mkdirSync(path.dirname(transcript), { recursive: true });
let lines = 0;
function record(entry) {
  lines++;
  fs.appendFileSync(transcript, JSON.stringify({ uuid: `${session}-${lines}`, timestamp: new Date().toISOString(), sessionId: session, ...entry }) + "\n");
}
const said = (content) => record({ type: "user", message: { role: "user", content } });
const wrote = (content) => record({ type: "assistant", message: { role: "assistant", content } });

const resetsIn = (seconds) => Math.floor(Date.now() / 1000) + seconds;
if (settings.statusLine?.command) {
  run(settings.statusLine.command, {
    session_id: session,
    rate_limits: { five_hour: { used_percentage: 23.5, resets_at: resetsIn(3600) }, seven_day: { used_percentage: 74, resets_at: resetsIn(86400) } },
  });
}

const KEYS = { "\x1b": "[esc]", "\t": "[tab]", "\x1b[Z": "[shift-tab]", "\x1b[A": "[up]", "\x1b[B": "[down]", "\x1bOA": "[up]", "\x1bOB": "[down]", "\x03": "[ctrl-c]" };
const out = (text) => process.stdout.write(text);
// A folder holding .untrusted asks first, as claude does in a folder it hasn't seen: unnumbered, "No" chosen.
let trusting = fs.existsSync(".untrusted") ? 1 : 0;
const TRUST = ["No, exit", "Yes, I trust this folder"];
function drawTrust() {
  out(`${"─".repeat(40)}\r\n Accessing workspace:\r\n\r\n ${process.cwd()}\r\n\r\n Quick safety check: is this a project you trust?\r\n\r\n`);
  TRUST.forEach((c, i) => out(`${i + 1 === trusting ? " ❯" : "  "} ${c}\r\n`));
  out("\r\n Enter to confirm · Esc to cancel\r\n");
}
const greet = () => out(`fake claude in ${process.cwd()}${args.includes("--dangerously-skip-permissions") ? " (bypass)" : ""}\r\n> `);
if (trusting) drawTrust();
else greet();

let line = "";
function submit() {
  out("\r\n");
  if (line === "/exit") process.exit(0);
  hook("UserPromptSubmit", { prompt: line });
  said(line);
  if (line === "/ask") {
    wrote([{ type: "tool_use", id: `ask-${lines}`, name: "Bash", input: { command: "rm -rf build", description: "Remove the build folder" } }]);
    hook("Notification", { message: "Claude needs your permission to use Bash" });
    asking = 1;
    drawMenu();
    line = "";
    return;
  } else if (line === "long") for (let i = 1; i <= 120; i++) out(`line ${i} of a long answer\r\n`);
  else if (line === "edit") {
    const id = `tool-${lines}`;
    wrote([{ type: "tool_use", id, name: "Edit", input: { file_path: path.join(process.cwd(), "notes.md"), old_string: "", new_string: "hello" } }]);
    fs.appendFileSync("notes.md", `edited at ${new Date().toISOString()}\nsecond line\n`);
    said([{ type: "tool_result", tool_use_id: id, content: "The file notes.md has been updated." }]);
    wrote([{ type: "text", text: "I edited **notes.md** and opened a pull request.\n\n- one change\n- `notes.md`" }]);
    record({ type: "pr-link", prNumber: 42, prUrl: "https://github.com/example/alpha/pull/42", prRepository: "example/alpha" });
    out("edited notes.md\r\n");
  } else {
    wrote([{ type: "text", text: `echo: ${line}` }]);
    out(`echo: ${line}\r\n`);
  }
  if (line !== "/ask") hook("Stop");
  line = "";
  out("> ");
}

// A permission menu drawn the way claude draws one, answered with the arrows and Enter.
const CHOICES = ["Yes", "Yes, and don't ask again for rm commands", "No, and tell Claude what to do differently (esc)"];
let asking = 0;
function drawMenu() {
  out(`${"─".repeat(40)}\r\n Bash command\r\n   rm -rf build\r\n Do you want to proceed?\r\n`);
  CHOICES.forEach((c, i) => out(`${i + 1 === asking ? " ❯" : "  "} ${i + 1}. ${c}\r\n`));
  out(" Esc to cancel\r\n");
}
function answerMenu(key) {
  if (key === "\x1b[B" || key === "\x1b[A") {
    asking = Math.min(CHOICES.length, Math.max(1, asking + (key === "\x1b[B" ? 1 : -1)));
    return drawMenu();
  }
  if (key !== "\r" && key !== "\x1b") return;
  out(`chose ${key === "\x1b" ? "esc" : asking}\r\n`);
  asking = 0;
  hook("Stop");
  out("> ");
}

process.stdin.setRawMode?.(true);
process.stdin.on("data", (chunk) => {
  // A prompt pinned types arrives as a bracketed paste, which claude reads as plain text.
  const text = chunk.toString("utf8").replace(/\x1b\[20[01]~/g, "");
  if (trusting) {
    for (const key of text.match(/\x1b\[[AB]|[\s\S]/g)) {
      if (key === "\x1b[B" || key === "\x1b[A") {
        trusting = key === "\x1b[B" ? 2 : 1;
        drawTrust();
      } else if (key === "\r") {
        if (trusting === 1) process.exit(0);
        trusting = 0;
        greet();
      }
    }
    return;
  }
  if (asking) {
    for (const key of text.match(/\x1b\[[AB]|[\s\S]/g)) answerMenu(key);
    return;
  }
  if (KEYS[text]) return out(KEYS[text]);
  for (const c of text) {
    if (c === "\r") submit();
    else if (c === "\x7f") line = line.slice(0, -1);
    else if (KEYS[c]) out(KEYS[c]);
    else {
      line += c;
      out(c);
    }
  }
});
