#!/usr/bin/env node
// Stands in for `claude` on the sweep's node: it calls the same hooks and statusline that
// pinned's --settings file names, and prints every key it gets, so a test can read them back.
const { execFileSync } = require("child_process");
const fs = require("fs");
const path = require("path");

const args = process.argv.slice(2);
const settingsFile = args[args.indexOf("--settings") + 1];
const settings = settingsFile ? JSON.parse(fs.readFileSync(settingsFile, "utf8")) : {};
// --resume carries on the named session, so its transcript grows where it left off, as claude's does.
const resumed = args.includes("--resume") ? args[args.indexOf("--resume") + 1] : null;
const session = resumed ?? `fake-${process.pid}`;

function run(command, input) {
  try {
    execFileSync("/bin/sh", ["-c", command], { input: JSON.stringify(input), stdio: ["pipe", "ignore", "ignore"] });
  } catch {}
}
const hook = (event, extra = {}) => {
  const command = settings.hooks?.[event]?.[0]?.hooks?.[0]?.command;
  if (command) run(command, { session_id: session, cwd: process.cwd(), ...extra });
};
const transcript = path.join(process.env.HOME, ".claude", "projects", process.cwd().replace(/[^a-zA-Z0-9]/g, "-"), `${session}.jsonl`);
fs.mkdirSync(path.dirname(transcript), { recursive: true });
let lines = 0;
function record(entry) {
  lines++;
  fs.appendFileSync(transcript, JSON.stringify({ uuid: `${session}-${lines}`, timestamp: new Date().toISOString(), sessionId: session, ...entry }) + "\n");
}
const said = (content) => record({ type: "user", message: { role: "user", content } });
const wrote = (content) => record({ type: "assistant", message: { role: "assistant", content } });
function used(name, input, content, is_error = false) {
  const id = `tool-${lines}`;
  wrote([{ type: "tool_use", id, name, input }]);
  said([{ type: "tool_result", tool_use_id: id, content, is_error }]);
}
const DOT_PNG = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==";
// Each takes a while, as claude would, and ends the turn itself.
const SLOW = {
  "/compact": () => record({ type: "user", isCompactSummary: true, message: { role: "user", content: "This session is being continued from a previous conversation." } }),
  think: () => wrote([{ type: "text", text: "Done thinking." }]),
  build: () => {
    said([{ type: "tool_result", tool_use_id: building, content: "built in 4s" }]);
    wrote([{ type: "text", text: "Built." }]);
  },
};
let building = "";

const resetsIn = (seconds) => Math.floor(Date.now() / 1000) + seconds;
if (settings.statusLine?.command) {
  run(settings.statusLine.command, {
    session_id: session,
    rate_limits: { five_hour: { used_percentage: 23.5, resets_at: resetsIn(3600) }, seven_day: { used_percentage: 74, resets_at: resetsIn(86400) } },
  });
}

const KEYS = { "\x1b": "[esc]", "\t": "[tab]", "\x1b[Z": "[shift-tab]", "\x1b[A": "[up]", "\x1b[B": "[down]", "\x1bOA": "[up]", "\x1bOB": "[down]", "\x03": "[ctrl-c]" };
const out = (text) => process.stdout.write(text);
const UNTRUSTED_MARKER = ".untrusted";
let trusting = fs.existsSync(UNTRUSTED_MARKER) ? 1 : 0;
const TRUST = ["No, exit", "Yes, I trust this folder"];
function drawTrust() {
  out(`${"─".repeat(40)}\r\n Accessing workspace:\r\n\r\n ${process.cwd()}\r\n\r\n Quick safety check: is this a project you trust?\r\n\r\n`);
  TRUST.forEach((c, i) => out(`${i + 1 === trusting ? " ❯" : "  "} ${c}\r\n`));
  out("\r\n Enter to confirm · Esc to cancel\r\n");
}
const greet = () => out(`fake claude in ${process.cwd()}${args.includes("--dangerously-skip-permissions") ? " (bypass)" : ""}\r\n> `);
if (resumed) out(`resumed ${resumed}\r\n`);
if (trusting) drawTrust();
else greet();

let line = "";
function submit() {
  out("\r\n");
  if (line === "/exit") process.exit(0);
  hook("UserPromptSubmit", { prompt: line });
  said(line);
  if (line === "/ask") {
    wrote([{ type: "tool_use", id: `ask-${lines}`, name: "Bash", input: { command: "rm -rf build", description: "Remove the build folder" } }]);
    hook("Notification", { message: "Claude needs your permission to use Bash" });
    asking = 1;
    drawMenu();
    line = "";
    return;
  } else if (SLOW[line]) {
    const finish = SLOW[line];
    if (line === "think") wrote([{ type: "thinking", thinking: "**Weighing the options**\n\nComparing the two approaches before answering.", signature: "c2ln" }]);
    if (line === "build") {
      building = `tool-${lines}`;
      wrote([{ type: "tool_use", id: building, name: "Bash", input: { command: "npm run build", description: "Build the app" } }]);
    }
    setTimeout(() => {
      finish();
      hook("Stop");
      out("> ");
    }, 4000);
    line = "";
    return;
  } else if (line === "long") for (let i = 1; i <= 120; i++) out(`line ${i} of a long answer\r\n`);
  else if (line === "rich") {
    const cwd = process.cwd();
    wrote([{ type: "thinking", thinking: "**Planning the read**\n\nI'll look at the notes first. Then run the tests.", signature: "c2ln" }]);
    used("Read", { file_path: path.join(cwd, "a.md") }, "alpha");
    used("Read", { file_path: path.join(cwd, "b.md") }, "beta");
    used("Bash", { command: "cargo test", description: "Run the tests" }, "test result: ok");
    used("Bash", { command: "false", description: "Check the build" }, "Exit code 1", true);
    wrote([{ type: "text", text: "Looked around; one check failed." }]);
    used("Grep", { pattern: "TODO" }, "No matches found");
    wrote([{ type: "text", text: "Here is the fix:\n\n```rust\nfn main() {\n    let answer = 42;\n}\n```\n\nSee [the pull request](https://github.com/example/beta/pull/7) and [the docs](https://example.com/docs)." }]);
  } else if (line === "plan") {
    const steps = Array.from({ length: 24 }, (_, i) => `${i + 1}. Step ${i + 1} of the plan`).join("\n");
    used("ExitPlanMode", { plan: `# Ship the fix\n\n## Summary\n\nPatch the parser, then test it.\n\n${steps}` }, "User has approved your plan. You can now start coding.");
    wrote([{ type: "text", text: "Plan approved." }]);
  } else if (line === "ask") {
    used("AskUserQuestion", { questions: [{ question: "Which color should the button be?", header: "Color", multiSelect: false, options: [{ label: "Blue", description: "Calm" }, { label: "Red", description: "Loud" }] }] },
      'Your questions have been answered: "Which color should the button be?"="Blue". You can now continue with these answers in mind.');
    wrote([{ type: "text", text: "Blue it is." }]);
  } else if (line === "oops") {
    record({ type: "assistant", isApiErrorMessage: true, message: { role: "assistant", model: "<synthetic>", content: [{ type: "text", text: "API Error: 529 Overloaded\nThe service is busy. Try again in a moment." }] } });
  } else if (line === "fail") {
    wrote([{ type: "text", text: "Building it now." }]);
    used("Bash", { command: "npm run build", description: "Build the app" }, "Error: the build failed\nsrc/app.ts(3,1): missing semicolon", true);
  } else if (line === "stop") {
    used("Bash", { command: "sleep 100", description: "Wait" }, "[Request interrupted by user for tool use]", true);
    said([{ type: "text", text: "[Request interrupted by user for tool use]" }]);
  } else if (line === "picture") {
    said([{ type: "text", text: "What is in this picture?" }, { type: "image", source: { type: "base64", media_type: "image/png", data: DOT_PNG } }]);
    wrote([{ type: "text", text: "A single dot." }]);
  } else if (line === "long-prompt") {
    const paragraph = "Please read @src/app/main.rs and explain every line of it in detail, with examples.";
    said(Array.from({ length: 12 }, (_, i) => `${i + 1}. ${paragraph}`).join("\n"));
    wrote([{ type: "text", text: "Here is the walkthrough." }]);
  } else if (line === "tree") {
    for (const dir of ["src/app", "docs"]) fs.mkdirSync(dir, { recursive: true });
    fs.writeFileSync("src/app/main.rs", "fn main() {}\n");
    fs.writeFileSync("src/app/lib.rs", "pub fn lib() {}\n");
    fs.writeFileSync("docs/guide.md", Array.from({ length: 1200 }, (_, i) => `line ${i}`).join("\n") + "\n");
    fs.writeFileSync("README.md", "# beta\n");
    wrote([{ type: "text", text: "Wrote the tree." }]);
  } else if (line === "many") {
    for (let i = 1; i <= 45; i++) {
      said(`question ${i}`);
      wrote([{ type: "text", text: `answer ${i}` }]);
    }
  }
  else if (line === "edit") {
    const id = `tool-${lines}`;
    wrote([{ type: "tool_use", id, name: "Edit", input: { file_path: path.join(process.cwd(), "notes.md"), old_string: "", new_string: "hello" } }]);
    fs.appendFileSync("notes.md", `edited at ${new Date().toISOString()}\nsecond line\n`);
    said([{ type: "tool_result", tool_use_id: id, content: "The file notes.md has been updated." }]);
    wrote([{ type: "text", text: "I edited **notes.md** and opened a pull request.\n\n- one change\n- `notes.md`" }]);
    record({ type: "pr-link", prNumber: 41, prUrl: "https://github.com/example/alpha/pull/41", prRepository: "example/alpha" });
    record({ type: "pr-link", prNumber: 42, prUrl: "https://github.com/example/alpha/pull/42", prRepository: "example/alpha" });
    out("edited notes.md\r\n");
  } else if (line === "code") {
    const id = `tool-${lines}`;
    const source = 'const answer = 42; // the answer\nfunction greet(name) {\n  return "hi " + name;\n}\n';
    wrote([{ type: "tool_use", id, name: "Write", input: { file_path: path.join(process.cwd(), "app.js"), content: source } }]);
    fs.writeFileSync("app.js", source);
    if (fs.existsSync("notes.md")) fs.writeFileSync("notes.md", fs.readFileSync("notes.md", "utf8").replace(/^second line$/gm, "  second line"));
    said([{ type: "tool_result", tool_use_id: id, content: "File created." }]);
    wrote([{ type: "text", text: "I wrote app.js and indented notes.md." }]);
    out("wrote app.js\r\n");
  } else if (line === "serve") {
    // The address stays out of the transcript, so only port discovery can find the server.
    const server = require("http").createServer((req, res) => {
      const send = () => {
        res.setHeader("content-type", "text/html; charset=utf-8");
        res.end("<!doctype html><title>Sweep server</title><p>served by fake claude</p>");
      };
      req.url === "/slow" ? setTimeout(send, 2500) : send();
    });
    server.listen(0, "127.0.0.1", () => {
      fs.writeFileSync(path.join(process.env.HOME, "serve.port"), String(server.address().port));
      out(`serving on ${server.address().port}\r\n`);
    });
    wrote([{ type: "text", text: "Started a web server." }]);
  } else {
    wrote([{ type: "text", text: `echo: ${line}` }]);
    out(`echo: ${line}\r\n`);
  }
  if (line !== "/ask") hook("Stop");
  line = "";
  out("> ");
}

const CHOICES = ["Yes", "Yes, and don't ask again for rm commands", "No, and tell Claude what to do differently (esc)"];
let asking = 0;
function drawMenu() {
  const box = "╌".repeat(40);
  out(`${"─".repeat(40)}\r\n Bash command\r\n Tip: auto mode handles these prompts for you\r\n Remove the build folder\r\n${box}\r\n rm -rf build\r\n${box}\r\n Do you want to proceed?\r\n`);
  CHOICES.forEach((c, i) => out(`${i + 1 === asking ? " ❯" : "  "} ${i + 1}. ${c}\r\n`));
  out(" Esc to cancel\r\n");
}
function answerMenu(key) {
  if (key === "\x1b[B" || key === "\x1b[A") {
    asking = Math.min(CHOICES.length, Math.max(1, asking + (key === "\x1b[B" ? 1 : -1)));
    return drawMenu();
  }
  if (key !== "\r" && key !== "\x1b") return;
  out(`chose ${key === "\x1b" ? "esc" : asking}\r\n`);
  asking = 0;
  setTimeout(() => {
    out("ran it\r\n");
    hook("Stop");
    out("> ");
  }, 4000);
}

process.stdin.setRawMode?.(true);
process.stdin.on("data", (chunk) => {
  // A prompt pinned types arrives as a bracketed paste, which claude reads as plain text.
  const text = chunk.toString("utf8").replace(/\x1b\[20[01]~/g, "");
  if (trusting) {
    for (const key of text.match(/\x1b\[[AB]|[\s\S]/g)) {
      if (key === "\x1b[B" || key === "\x1b[A") {
        trusting = key === "\x1b[B" ? 2 : 1;
        drawTrust();
      } else if (key === "\r") {
        if (trusting === 1) process.exit(0);
        trusting = 0;
        greet();
      }
    }
    return;
  }
  if (asking) {
    for (const key of text.match(/\x1b\[[AB]|[\s\S]/g)) answerMenu(key);
    return;
  }
  if (KEYS[text]) return out(KEYS[text]);
  for (const c of text) {
    if (c === "\r") submit();
    else if (c === "\x7f") line = line.slice(0, -1);
    else if (KEYS[c]) out(KEYS[c]);
    else {
      line += c;
      out(c);
    }
  }
});
