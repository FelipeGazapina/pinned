#!/usr/bin/env node
// Stands in for `npx` on the sweep's node: `npx -y expo-device-hub@<version> --host H --port P` serves
// the routes of Expo's device hub that the Device tab uses, in the hub's shapes: an iPhone simulator
// that is off, a running Pixel emulator, serve-emu's H.264 socket and REST input, serve-sim's MJPEG,
// and the accessibility trees. Each run goes to $HOME/npx.log, and what devices are asked to do to
// $HOME/hub.log.
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");

const args = process.argv.slice(2);
const log = (file, line) => fs.appendFileSync(path.join(process.env.HOME, file), `${line}\n`);
log("npx.log", args.join(" "));
const flag = (name) => (args.includes(name) ? args[args.indexOf(name) + 1] : undefined);
if (!args.some((a) => a.startsWith("expo-device-hub@"))) {
  process.stderr.write(`fake npx can't run ${args.join(" ")}\n`);
  process.exit(1);
}
// A 216×480 teal keyframe, an orange PNG screenshot and a slate JPEG, each made with ffmpeg. The keyframe is
// BT.709 limited range and says so, since that is what WebCodecs assumes of H.264 that stays silent:
// ffmpeg -f lavfi -i color=c=0x2a9d8f:s=216x480:r=2 -vf scale=out_color_matrix=bt709:out_range=tv -c:v libx264
//   -profile:v baseline -colorspace bt709 -color_primaries bt709 -color_trc bt709 -pix_fmt yuv420p
//   -x264-params keyint=1:min-keyint=1:bframes=0:threads=1 -frames:v 1 -f h264
const KEYFRAME = Buffer.from("", "base64");
const SCREENSHOT = Buffer.from("", "base64");
const JPEG = Buffer.from("", "base64");

const UDID = "5A1C7E0B-2D7A-4E1B-9C3D-6F8A9B0C1D2E";
const devices = {
  simulators: [{ id: UDID, name: "iPhone 17", version: "iOS 26.0", platform: "ios", booted: false, physical: false }],
  emulators: [{ id: "emulator-5554", name: "Pixel_9", version: "Android 16", platform: "android", booted: true, physical: false }],
};
const port = Number(flag("--port"));
const json = (res, body, status = 200) => {
  res.writeHead(status, { "content-type": "application/json" });
  res.end(JSON.stringify(body));
};
const readBody = (req) => new Promise((done) => {
  let text = "";
  req.on("data", (c) => (text += c));
  req.on("end", () => done(text ? JSON.parse(text) : {}));
});

const server = require("http").createServer(async (req, res) => {
  const url = new URL(req.url, `http://127.0.0.1:${port}`);
  const at = url.pathname;
  const device = url.searchParams.get("device");
  // serve-emu refuses a browser's mutation from any origin but its own.
  if (req.method === "POST" && at.startsWith("/vendor/serve-emu/") && req.headers.origin && req.headers.origin !== url.origin) {
    return json(res, { ok: false, error: { code: "forbidden", message: "Browser origin is not allowed to mutate serve-emu state" } }, 403);
  }
  if (at === "/api/devices") return json(res, { ...devices, errors: [] });
  if (at === "/api/devices/boot") {
    const body = await readBody(req);
    log("hub.log", `boot ${body.platform} ${body.id} ${body.name}`);
    const d = [...devices.simulators, ...devices.emulators].find((x) => x.id === body.id);
    if (d) d.booted = true;
    return setTimeout(() => json(res, { ok: true, id: body.id, errors: [] }), 800);
  }
  if (at === "/api/devices/shutdown" || at === "/vendor/serve-sim/grid/api/shutdown") {
    const body = await readBody(req);
    const id = body.id ?? body.udid;
    log("hub.log", `shutdown ${id}`);
    const d = [...devices.simulators, ...devices.emulators].find((x) => x.id === id);
    if (d) d.booted = false;
    return json(res, { ok: true });
  }
  if (at === "/vendor/serve-sim/grid/api/start") {
    const body = await readBody(req);
    log("hub.log", `attach ${body.udid}`);
    return json(res, { ok: true });
  }
  if (at.endsWith("/api/screenshot")) {
    log("hub.log", `screenshot ${device}`);
    res.writeHead(200, { "content-type": "image/png" });
    return res.end(SCREENSHOT);
  }
  if (/^\/vendor\/serve-emu\/api\/(tap|swipe|text|key)$/.test(at)) {
    log("hub.log", `rest ${at.split("/").pop()} ${device} ${JSON.stringify(await readBody(req))}`);
    return json(res, { ok: true });
  }
  if (at === "/vendor/serve-emu/api/accessibility") {
    return json(res, { ok: true, nodes: [
      { id: "0", text: "", className: "android.widget.FrameLayout", clickable: false, bounds: { left: 0, top: 0, right: 1080, bottom: 2400 } },
      { id: "1", text: "Sign in", contentDescription: "", className: "android.widget.Button", clickable: true, bounds: { left: 270, top: 1800, right: 810, bottom: 1950 } },
    ] });
  }
  if (at === `/vendor/serve-sim/helper/${UDID}/ax`) return json(res, [{ frame: { x: 0, y: 0, width: 402, height: 874 }, children: [{ AXLabel: "Continue", AXUniqueId: "go", type: "Button", frame: { x: 100, y: 700, width: 200, height: 50 } }] }]);
  if (at === `/vendor/serve-sim/helper/${UDID}/stream.mjpeg`) {
    res.writeHead(200, { "content-type": "multipart/x-mixed-replace; boundary=frame" });
    const send = () => res.write(Buffer.concat([Buffer.from(`--frame\r\nContent-Type: image/jpeg\r\nContent-Length: ${JPEG.length}\r\n\r\n`), JPEG, Buffer.from("\r\n")]));
    send();
    const every = setInterval(send, 500);
    return req.on("close", () => clearInterval(every));
  }
  res.setHeader("content-type", "text/html; charset=utf-8");
  if (flag("--frame-ancestor")) res.setHeader("content-security-policy", `frame-ancestors ${flag("--frame-ancestor")}`);
  res.end("<!doctype html><title>Expo Device Hub</title><p>Expo Device Hub dashboard</p>");
});

// The few parts of RFC 6455 the two sockets need: unmasked frames out, masked frames in.
function frame(opcode, payload) {
  const n = payload.length;
  const head = n < 126 ? Buffer.from([0x80 | opcode, n]) : n < 65536 ? Buffer.from([0x80 | opcode, 126, n >> 8, n & 255]) : null;
  return Buffer.concat([head, payload]);
}
function readFrames(socket, onMessage) {
  let buffer = Buffer.alloc(0);
  socket.on("data", (chunk) => {
    buffer = Buffer.concat([buffer, chunk]);
    while (buffer.length >= 2) {
      const opcode = buffer[0] & 15;
      let n = buffer[1] & 127;
      let at = 2;
      if (n === 126) [n, at] = [buffer.readUInt16BE(2), 4];
      if (buffer.length < at + 4 + n) return;
      const mask = buffer.subarray(at, at + 4);
      const data = Buffer.from(buffer.subarray(at + 4, at + 4 + n).map((b, i) => b ^ mask[i % 4]));
      buffer = buffer.subarray(at + 4 + n);
      if (opcode === 8) return socket.end();
      onMessage(opcode, data);
    }
  });
}
server.on("upgrade", (req, socket) => {
  const url = new URL(req.url, `http://127.0.0.1:${port}`);
  const accept = crypto.createHash("sha1").update(`${req.headers["sec-websocket-key"]}258EAFA5-E914-47DA-95CA-C5AB0DC85B11`).digest("base64");
  socket.write(`HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ${accept}\r\n\r\n`);
  const device = url.searchParams.get("device");
  if (url.pathname === "/vendor/serve-emu/ws") {
    log("hub.log", `stream ${device} ${url.search}`);
    socket.write(frame(1, Buffer.from(JSON.stringify({ type: "video-session", size: { width: 216, height: 480 } }))));
    // serve-emu's v1 frame header: "SEMU", version 1, flags (keyframe), two spare bytes, pts in µs.
    let pts = 0n;
    const send = () => {
      const head = Buffer.alloc(16);
      head.writeUInt32BE(0x53454d55, 0);
      head[4] = 1;
      head[5] = 1;
      head.writeBigUInt64BE((pts += 500000n), 8);
      if (!socket.destroyed) socket.write(frame(2, Buffer.concat([head, KEYFRAME])));
    };
    send();
    const every = setInterval(send, 500);
    socket.on("close", () => clearInterval(every));
    readFrames(socket, (opcode, data) => opcode === 1 && log("hub.log", `ws ${device} ${data.toString()}`));
  } else if (url.pathname === "/vendor/serve-sim/helper/ws") {
    readFrames(socket, (opcode, data) => opcode === 2 && log("hub.log", `hid ${device} ${data[0]} ${data.subarray(1).toString()}`));
  } else socket.destroy();
  socket.on("error", () => {});
});
server.listen(port, flag("--host") ?? "127.0.0.1");
// A node killed outright leaves its hub behind; this one doesn't outlive a sweep.
setTimeout(() => process.exit(0), 30 * 60 * 1000);
