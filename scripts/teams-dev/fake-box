#!/usr/bin/env node
// Stands in for the Upstash Box API in the Teams dev stack (scripts/teams-dev/dev.sh). It answers on
// 127.0.0.1 only, keeps its boxes in memory and under $TEAMS_DEV_DIR/boxes/<id>/, and runs a box's
// commands as plain local processes whose HOME is the box's home directory.
//
//   fake-box [port]        port defaults to $FAKE_BOX_PORT, then 8812
//
// Endpoints, as crates/core/src/upstash.rs calls them (all need X-Box-Api-Key: box_dev-…):
//   GET    /v2/box[?label=L]      the boxes (`id`, `labels`, and what the Usage page reads)
//   POST   /v2/box               creates one: name, labels, size, keep_alive, init_command
//   GET    /v2/box/{id}          one box, with its `status`
//   POST   /v2/box/{id}/files/write   { path, content }
//   POST   /v2/box/{id}/exec     { command: [...] } -> { exit_code, output, error } (+ stdout, stderr)
//   DELETE /v2/box/{id}          kills the box's processes and removes its directory
//
// A box's /workspace/home is <dir>/home and its /tmp is <dir>/tmp, in every path and command the hub
// sends. Its commands see only PATH (the web sweep's fake claude, gh and npx first), HOME, TMPDIR,
// SHELL, CLAUDE_CONFIG_DIR and the box's id: no token of the developer's, no real Upstash.
// FAKE_BOX_CREATE_MS (default 0) keeps a new box `creating` that long, to exercise the hub's polling.
const http = require("http");
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");
const { spawn } = require("child_process");

const KEY_PREFIX = "box_dev-";
const REPO = path.resolve(__dirname, "../..");
const ROOT = process.env.TEAMS_DEV_DIR;
if (!ROOT) {
  console.error("fake-box: TEAMS_DEV_DIR is not set");
  process.exit(2);
}
const BOXES = path.join(ROOT, "boxes");
const BIN = path.join(ROOT, "box-bin");
const port = Number(process.argv[2] || process.env.FAKE_BOX_PORT || 8812);
const CREATE_MS = Number(process.env.FAKE_BOX_CREATE_MS || 0);
const ID_ENV = "PINNED_FAKE_BOX_ID";

/** The box's commands run by `claude`, `gh`, `npx` and the login `shell` the sweep's node expects. */
function installBin() {
  fs.mkdirSync(BIN, { recursive: true });
  const sweep = path.join(REPO, "scripts/web-sweep");
  for (const [from, to] of [["fake-claude", "claude"], ["fake-gh", "gh"], ["fake-npx", "npx"]]) {
    fs.copyFileSync(path.join(sweep, from), path.join(BIN, to));
    fs.chmodSync(path.join(BIN, to), 0o755);
  }
  fs.writeFileSync(path.join(BIN, "shell"), '#!/bin/sh\nshift\nexec /bin/sh -c "$1"\n', { mode: 0o755 });
  fs.writeFileSync(path.join(BIN, "open"), '#!/bin/sh\necho "$@" >>"$HOME/open.log"\n', { mode: 0o755 });
}

const boxes = new Map();
const dirOf = (id) => path.join(BOXES, id);
const homeOf = (id) => path.join(dirOf(id), "home");
const tmpOf = (id) => path.join(dirOf(id), "tmp");
const save = (box) => fs.writeFileSync(path.join(dirOf(box.id), "box.json"), JSON.stringify(box, null, 2));

/** `text` with the box's own paths: /workspace/home is its home, /tmp its temp directory. */
function inBox(id, text) {
  return String(text).replace(/(?<![\w.\-/])\/workspace\/home(?![\w.\-])|(?<![\w.\-/])\/tmp(?![\w.\-])/g, (m) => (m === "/tmp" ? tmpOf(id) : homeOf(id)));
}

function envOf(id) {
  const env = {
    PATH: `${BIN}:/usr/local/bin:/usr/bin:/bin`,
    HOME: homeOf(id),
    TMPDIR: tmpOf(id),
    SHELL: path.join(BIN, "shell"),
    CLAUDE_CONFIG_DIR: path.join(homeOf(id), ".claude"),
    LANG: "C.UTF-8",
    USER: "box",
    UPSTASH_BOX_BASE_URL: process.env.UPSTASH_BOX_BASE_URL || `http://127.0.0.1:${port}`,
    [ID_ENV]: id,
  };
  for (const name of ["PINNED_DEV_TIME_SCALE", "PINNED_SLACK_API_BASE"]) if (process.env[name]) env[name] = process.env[name];
  return env;
}

let execs = 0;
/** Runs `argv` in the box. Output goes to files, not pipes, so a node the command leaves running holds nothing open. */
function run(id, argv, wait = 5 * 60 * 1000) {
  return new Promise((resolve) => {
    const n = ++execs;
    const out = path.join(tmpOf(id), `exec-${n}.out`);
    const err = path.join(tmpOf(id), `exec-${n}.err`);
    const [fo, fe] = [fs.openSync(out, "w"), fs.openSync(err, "w")];
    const args = argv.map((a) => inBox(id, a));
    const child = spawn(args[0], args.slice(1), { cwd: homeOf(id), env: envOf(id), stdio: ["ignore", fo, fe], detached: true });
    fs.closeSync(fo);
    fs.closeSync(fe);
    const timer = setTimeout(() => child.kill("SIGKILL"), wait);
    const done = (code, extra = "") => {
      clearTimeout(timer);
      const read = (f) => fs.readFileSync(f, "utf8");
      const [output, error] = [read(out), read(err) + extra];
      fs.rmSync(out, { force: true });
      fs.rmSync(err, { force: true });
      resolve({ exit_code: code, output, error, stdout: output, stderr: error });
    };
    child.on("error", (e) => done(127, `${e.message}\n`));
    child.on("close", (code, signal) => done(code ?? (signal ? 128 : 1)));
  });
}

/** Every process whose environment carries this box's id: what its commands started, however deep. */
function processesOf(id) {
  const marker = `${ID_ENV}=${id}\0`;
  const found = [];
  for (const name of fs.readdirSync("/proc")) {
    if (!/^\d+$/.test(name) || Number(name) === process.pid) continue;
    try {
      if (fs.readFileSync(`/proc/${name}/environ`, "latin1").includes(marker)) found.push(Number(name));
    } catch {}
  }
  return found;
}

async function killProcesses(id) {
  for (const signal of ["SIGTERM", "SIGKILL"]) {
    const pids = processesOf(id);
    if (!pids.length) return;
    for (const pid of pids) try { process.kill(pid, signal); } catch {}
    await new Promise((r) => setTimeout(r, signal === "SIGTERM" ? 1500 : 200));
  }
}

function view(box) {
  const status = box.status === "creating" && Date.now() - box.created_at >= CREATE_MS ? "running" : box.status;
  return { id: box.id, name: box.name, labels: box.labels, size: box.size, status, keep_alive: box.keep_alive, created_at: box.created_at, last_activity_at: box.last_activity_at, total_cpu_ns: 0, total_compute_cost_usd: 0 };
}

function load() {
  fs.mkdirSync(BOXES, { recursive: true });
  for (const id of fs.readdirSync(BOXES)) {
    try {
      boxes.set(id, JSON.parse(fs.readFileSync(path.join(dirOf(id), "box.json"), "utf8")));
    } catch {}
  }
}

async function readJson(req) {
  const chunks = [];
  let size = 0;
  for await (const c of req) {
    size += c.length;
    if (size > 16 << 20) throw Object.assign(new Error("body too large"), { status: 413 });
    chunks.push(c);
  }
  const text = Buffer.concat(chunks).toString("utf8");
  try {
    return text.trim() ? JSON.parse(text) : {};
  } catch {
    throw Object.assign(new Error("the body is not JSON"), { status: 400 });
  }
}

const fail = (status, message) => Object.assign(new Error(message), { status });

async function handle(req, res) {
  const url = new URL(req.url, "http://fake");
  const key = req.headers["x-box-api-key"] || "";
  if (!String(key).startsWith(KEY_PREFIX)) throw fail(401, `the fake Box accepts only keys starting ${KEY_PREFIX}`);
  const parts = url.pathname.split("/").filter(Boolean); // v2 box [id [files/write | exec]]
  if (parts[0] !== "v2" || parts[1] !== "box") throw fail(404, "no such route");
  const [, , id, ...rest] = parts;
  const m = req.method;
  if (!id) {
    if (m === "GET") {
      const label = url.searchParams.get("label");
      return [...boxes.values()].filter((b) => !label || b.labels.includes(label)).map(view);
    }
    if (m === "POST") {
      const body = await readJson(req);
      const box = { id: `devbox-${crypto.randomBytes(4).toString("hex")}`, name: String(body.name || ""), labels: Array.isArray(body.labels) ? body.labels : [], size: body.size ?? "small", keep_alive: !!body.keep_alive, init_command: String(body.init_command || ""), status: "creating", created_at: Date.now(), last_activity_at: Date.now() };
      for (const d of [homeOf(box.id), tmpOf(box.id), path.join(homeOf(box.id), ".claude")]) fs.mkdirSync(d, { recursive: true });
      boxes.set(box.id, box);
      save(box);
      if (CREATE_MS <= 0) box.status = "running";
      setTimeout(() => {
        if (boxes.has(box.id)) { box.status = "running"; save(box); }
      }, CREATE_MS);
      save(box);
      return view(box);
    }
    throw fail(405, "method not allowed");
  }
  const box = boxes.get(id);
  if (!box) throw fail(404, `no box ${id}`);
  box.last_activity_at = Date.now();
  if (!rest.length) {
    if (m === "GET") return view(box);
    if (m === "DELETE") {
      boxes.delete(id);
      await killProcesses(id);
      fs.rmSync(dirOf(id), { recursive: true, force: true });
      return {};
    }
    throw fail(405, "method not allowed");
  }
  if (m !== "POST") throw fail(405, "method not allowed");
  if (rest.join("/") === "files/write") {
    const body = await readJson(req);
    if (typeof body.path !== "string" || !path.isAbsolute(body.path) || typeof body.content !== "string") throw fail(400, "files/write takes an absolute path and a string content");
    const target = path.resolve(inBox(id, body.path));
    if (![homeOf(id), tmpOf(id)].some((root) => target === root || target.startsWith(root + path.sep))) throw fail(400, `the fake Box writes only under /workspace/home and /tmp, not ${body.path}`);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, body.content, { mode: 0o644 });
    save(box);
    return {};
  }
  if (rest.join("/") === "exec") {
    const body = await readJson(req);
    if (!Array.isArray(body.command) || !body.command.length || body.command.some((a) => typeof a !== "string")) throw fail(400, "exec takes command: [program, ...args]");
    return await run(id, body.command);
  }
  throw fail(404, "no such route");
}

const server = http.createServer(async (req, res) => {
  let status = 200;
  let body;
  try {
    body = await handle(req, res);
  } catch (e) {
    status = e.status || 500;
    body = { error: e.message };
  }
  console.log(`${new Date().toISOString()} ${req.method} ${new URL(req.url, "http://fake").pathname} ${status}`);
  res.writeHead(status, { "content-type": "application/json" });
  res.end(JSON.stringify(body));
});

let stopping = false;
async function stop() {
  if (stopping) return;
  stopping = true;
  server.close();
  await Promise.all([...boxes.keys()].map(killProcesses));
  process.exit(0);
}
process.on("SIGTERM", stop);
process.on("SIGINT", stop);

installBin();
load();
server.listen(port, "127.0.0.1", async () => {
  console.log(`fake-box listening on 127.0.0.1:${port}, boxes in ${BOXES}`);
  // Upstash runs a box's init_command on every container start: a restarted fake resumes its boxes.
  for (const box of boxes.values()) {
    if (box.init_command) run(box.id, ["sh", "-c", box.init_command]).then((r) => console.log(`resumed ${box.id}: exit ${r.exit_code}`));
  }
});
