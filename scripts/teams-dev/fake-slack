#!/usr/bin/env node
// Stands in for the Slack Web API in a dev stack, so no call reaches real Slack. It answers on
// 127.0.0.1 only, and takes a token only when it is `Bearer xoxb-dev-…`; any other gets invalid_auth.
//
//   scripts/teams-dev/fake-slack [--port 8813] [--log <file>]
//
// Point the stack at it with PINNED_SLACK_API_BASE=http://127.0.0.1:8813/api/. Each method is
// /api/<method>, called with GET query params or a POST body, JSON or form-encoded. Port 0 picks a
// free port and prints it on the "listening on" line. chat.postMessage lands in an in-memory
// thread, so a later conversations.replies returns it.
//
// Every call is recorded without its token: GET /sink lists the records as a JSON array, POST
// /sink/reset clears them, and --log appends each record as a JSON line.
const http = require("http");
const fs = require("fs");

const args = process.argv.slice(2);
const flag = (name, fallback) => {
  const i = args.indexOf(name);
  return i >= 0 && args[i + 1] !== undefined ? args[i + 1] : fallback;
};
const port = Number(flag("--port", 8813));
const logFile = flag("--log", "");
if (!Number.isInteger(port) || port < 0 || port > 65535) {
  console.error("usage: fake-slack [--port N] [--log FILE]");
  process.exit(2);
}

// The bot the dev token belongs to, and the workspace around it.
const BOT = { user: "UDEVBOT0001", bot: "BDEVBOT0001", app: "ADEVBOT0001", team: "Pinned Dev", teamId: "TDEVPINNED1", name: "pinned-dev" };
const users = new Map([
  ["U0DEVANA01", { name: "ana", real: "Ana Ribeiro", display: "ana" }],
  ["U0DEVBEN02", { name: "ben", real: "Ben Lima", display: "" }],
  [BOT.user, { name: BOT.name, real: "pinned", display: "pinned" }],
]);
const groups = [{ id: "S0DEVPROD1", handle: "prod-engg", name: "Production engineers", is_usergroup: true }];

const channels = new Map();
const addChannel = (id, name, member) => channels.set(id, { id, name, member, messages: [] });
addChannel("C0DEVGEN001", "general", true);
addChannel("C0DEVDEPLO", "deploys", true);
addChannel("C0DEVRAND01", "random", false);

// Messages keep their Slack timestamp in microseconds (`us`), which compares exactly.
let lastUs = 0;
const nextUs = () => (lastUs = Math.max(Date.now() * 1000, lastUs + 1));
const stamp = (us) => `${Math.floor(us / 1e6)}.${String(us % 1e6).padStart(6, "0")}`;
const micros = (ts) => {
  const [secs, frac = ""] = String(ts).split(".");
  const us = Number(secs) * 1e6 + Number(frac.padEnd(6, "0").slice(0, 6));
  return Number.isFinite(us) ? us : null;
};

// Seed history, so a dev stack has something to read before anything is posted. Times are
// relative to startup, inside the 90-day lookback the client reads.
const startUs = Date.now() * 1000;
const seed = (channel, user, text, secondsAgo, parent) => {
  const us = startUs - secondsAgo * 1e6;
  const m = { us, ts: stamp(us), user, text, thread_ts: parent?.ts, reactions: new Set() };
  channel.messages.push(m);
  return m;
};
seed(channels.get("C0DEVGEN001"), "U0DEVANA01", "lunch?", 900);
const parent = seed(channels.get("C0DEVDEPLO"), "U0DEVANA01", `<@${BOT.user}> the export button 500s`, 600);
seed(channels.get("C0DEVDEPLO"), "U0DEVBEN02", "I see it in the logs too", 300, parent);

class SlackError extends Error {}
const fail = (code) => {
  throw new SlackError(code);
};

const chan = (p) => channels.get(p.channel) ?? fail("channel_not_found");
const findMessage = (channel, ts, code = "message_not_found") => channel.messages.find((m) => m.us === micros(ts)) ?? fail(code);
const replyList = (channel, parentMessage) => channel.messages.filter((m) => m.thread_ts === parentMessage.ts);
const usOf = (value, fallback) => {
  if (value === undefined) return fallback;
  return micros(value) ?? fail("invalid_ts");
};

// One message as Slack shows it: a parent carries its thread's count and latest reply.
function view(channel, m) {
  const out = { type: "message", ts: m.ts, user: m.user, text: m.text };
  if (m.subtype) out.subtype = m.subtype;
  if (m.bot) out.bot_id = m.bot;
  if (m.thread_ts) out.thread_ts = m.thread_ts;
  const replies = replyList(channel, m);
  if (replies.length) Object.assign(out, { thread_ts: m.ts, reply_count: replies.length, latest_reply: replies.at(-1).ts });
  if (m.reactions.size) out.reactions = [...m.reactions].map((name) => ({ name, count: 1, users: [BOT.user] }));
  return out;
}

const channelView = (c) => ({ id: c.id, name: c.name, is_channel: true, is_private: false, is_archived: false, is_member: c.member });
const userView = (id, u) => ({ id, name: u.name, real_name: u.real, profile: { display_name: u.display, real_name: u.real } });

// Pages a list. A cursor is the offset of the next item, as a string, which is opaque to the client.
function page(items, p) {
  const limit = Math.min(Math.max(Number(p.limit) || 100, 1), 1000);
  const offset = Number(p.cursor) || 0;
  const more = offset + limit < items.length;
  return { slice: items.slice(offset, offset + limit), has_more: more, next_cursor: more ? String(offset + limit) : "" };
}

let origin = "";
const handlers = {
  "auth.test": () => ({ url: `${origin}/`, team: BOT.team, team_id: BOT.teamId, user: BOT.name, user_id: BOT.user, bot_id: BOT.bot }),
  "bots.info": (p) => {
    if (p.bot !== BOT.bot) fail("bot_not_found");
    return { bot: { id: BOT.bot, deleted: false, name: BOT.name, app_id: BOT.app, user_id: BOT.user } };
  },
  "conversations.list": () => ({ channels: [...channels.values()].map(channelView), response_metadata: { next_cursor: "" } }),
  "conversations.info": (p) => ({ channel: channelView(chan(p)) }),
  "conversations.history": (p) => {
    const c = chan(p);
    const oldest = usOf(p.oldest, -Infinity);
    const tops = c.messages.filter((m) => !m.thread_ts && m.us > oldest).reverse();
    const { slice, has_more, next_cursor } = page(tops, p);
    return { messages: slice.map((m) => view(c, m)), has_more, response_metadata: { next_cursor } };
  },
  "conversations.replies": (p) => {
    const c = chan(p);
    const root = findMessage(c, p.ts, "thread_not_found");
    if (root.thread_ts) fail("thread_not_found");
    const oldest = usOf(p.oldest, -Infinity);
    const thread = [root, ...replyList(c, root)].filter((m) => m.us > oldest);
    const { slice, has_more, next_cursor } = page(thread, p);
    return { messages: slice.map((m) => view(c, m)), has_more, response_metadata: { next_cursor } };
  },
  "chat.postMessage": (p) => {
    const c = chan(p);
    if (!p.text) fail("no_text");
    const root = p.thread_ts ? findMessage(c, p.thread_ts, "thread_not_found") : undefined;
    if (root?.thread_ts) fail("thread_not_found");
    const us = nextUs();
    const m = { us, ts: stamp(us), user: BOT.user, bot: BOT.bot, subtype: "bot_message", text: String(p.text), thread_ts: root?.ts, reactions: new Set() };
    c.messages.push(m);
    return { channel: c.id, ts: m.ts, message: view(c, m) };
  },
  "chat.getPermalink": (p) => {
    const c = chan(p);
    const m = findMessage(c, p.message_ts);
    const thread = m.thread_ts ?? m.ts;
    return { channel: c.id, permalink: `${origin}/archives/${c.id}/p${m.ts.replace(".", "")}?thread_ts=${thread}&cid=${c.id}` };
  },
  "reactions.add": (p) => {
    const c = chan(p);
    const m = findMessage(c, p.timestamp);
    if (!p.name) fail("invalid_name");
    if (m.reactions.has(p.name)) fail("already_reacted");
    m.reactions.add(p.name);
    return {};
  },
  "usergroups.list": () => ({ usergroups: groups }),
  "users.info": (p) => {
    const u = users.get(p.user) ?? fail("user_not_found");
    return { user: userView(p.user, u) };
  },
};

// Every Slack call, whether it was allowed or refused, as one record. The token is never in it.
const entries = [];
function record(entry) {
  entries.push(entry);
  if (logFile) fs.appendFileSync(logFile, JSON.stringify(entry) + "\n");
}
const PICKED = ["channel", "text", "thread_ts", "ts", "timestamp", "name", "user", "bot", "message_ts", "oldest"];
const picked = (p) => Object.fromEntries(PICKED.filter((k) => p[k] !== undefined).map((k) => [k, p[k]]));

function readBody(req) {
  return new Promise((resolve, reject) => {
    let body = "";
    req.setEncoding("utf8");
    req.on("data", (chunk) => (body += chunk));
    req.on("end", () => resolve(body));
    req.on("error", reject);
  });
}

// Query params, then the body: JSON when it says so, form-encoded otherwise.
function paramsOf(url, req, body) {
  const params = Object.fromEntries(url.searchParams);
  if (!body) return params;
  const json = (req.headers["content-type"] || "").includes("json") || body.trimStart().startsWith("{");
  if (!json) return { ...params, ...Object.fromEntries(new URLSearchParams(body)) };
  try {
    return { ...params, ...JSON.parse(body) };
  } catch {
    return null;
  }
}

function send(res, status, type, text) {
  res.writeHead(status, { "content-type": type });
  res.end(text);
}
const sendJson = (res, value) => send(res, 200, "application/json", JSON.stringify(value));

async function slackCall(req, res, url) {
  const method = url.pathname.slice("/api/".length);
  const body = await readBody(req);
  const p = paramsOf(url, req, body);
  const base = { at: new Date().toISOString(), method };
  if (!/^Bearer xoxb-dev-\S+$/.test(req.headers.authorization || "")) {
    record({ ...base, ok: false, error: "invalid_auth", ...(p ? picked(p) : {}) });
    return sendJson(res, { ok: false, error: "invalid_auth" });
  }
  if (p === null) {
    record({ ...base, ok: false, error: "invalid_arguments" });
    return sendJson(res, { ok: false, error: "invalid_arguments" });
  }
  let answer;
  if (!Object.hasOwn(handlers, method)) answer = { ok: false, error: "unknown_method" };
  else {
    try {
      answer = { ok: true, ...handlers[method](p) };
    } catch (e) {
      if (!(e instanceof SlackError)) throw e;
      answer = { ok: false, error: e.message };
    }
  }
  record({ ...base, ok: answer.ok, ...(answer.ok ? {} : { error: answer.error }), ...picked(p) });
  console.log(method, answer.ok ? "ok" : answer.error);
  sendJson(res, answer);
}

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, "http://127.0.0.1");
  if (url.pathname === "/health") return send(res, 200, "text/plain", "ok");
  if (url.pathname === "/sink" && req.method === "GET") return sendJson(res, entries);
  if (url.pathname === "/sink/reset" && req.method === "POST") {
    entries.length = 0;
    if (logFile) fs.writeFileSync(logFile, "");
    return sendJson(res, { ok: true });
  }
  if (url.pathname.startsWith("/api/")) return slackCall(req, res, url);
  send(res, 404, "application/json", "{}");
});

server.on("error", (e) => {
  console.error(`fake-slack: ${e.message}`);
  process.exit(1);
});
server.listen(port, "127.0.0.1", () => {
  origin = `http://127.0.0.1:${server.address().port}`;
  console.log(`fake-slack listening on ${origin}/api/`);
});
