#!/usr/bin/env node

const fs = require("fs");
const net = require("net");
const path = require("path");

const args = process.argv.slice(2);
const state = process.env.BENCH_STATE;

if (args[0] === "auth") {
  process.stdout.write(
    `${JSON.stringify({ loggedIn: true, email: "latency@example.test", subscriptionType: "max" })}\n`,
  );
  process.exit(0);
}
if (args.includes("-p") || args.includes("--version")) process.exit(0);
if (!state) {
  console.error("BENCH_STATE is not set");
  process.exit(1);
}

fs.mkdirSync(state, { recursive: true });
const session = `b${process.pid}`;
const cwd = process.cwd();
const slug = cwd.replace(/[^A-Za-z0-9]/g, "-");
const home = process.env.HOME || "";
const dir = path.join(home, ".claude", "projects", slug);
fs.mkdirSync(dir, { recursive: true });
const transcript = path.join(dir, `${session}.jsonl`);
const opening = {
  parentUuid: null,
  isSidechain: false,
  type: "assistant",
  uuid: `open-${session}`,
  timestamp: new Date().toISOString(),
  message: { role: "assistant", content: [{ type: "text", text: "ready" }] },
};
const fd = fs.openSync(transcript, "a");
fs.writeSync(fd, `${JSON.stringify(opening)}\n`);
fs.fsyncSync(fd);
fs.closeSync(fd);
fs.writeFileSync(path.join(state, "transcript"), transcript);
fs.writeFileSync(path.join(state, "session"), session);
if (process.env.PINNED_SOCK) fs.writeFileSync(path.join(state, "sock"), process.env.PINNED_SOCK);
if (process.env.PINNED_TAB) fs.writeFileSync(path.join(state, "tab"), process.env.PINNED_TAB);

const sock = process.env.PINNED_SOCK;
if (sock) {
  const message = {
    kind: "agent",
    status: "needs-input",
    cwd,
    message: null,
    tab: process.env.PINNED_TAB || null,
    session,
    title: "bench",
    resume_at: null,
    prompt: null,
    snapshot: null,
    hook_feedback: false,
  };
  const client = net.createConnection(sock);
  client.on("connect", () => client.end(`${JSON.stringify(message)}\n`));
  client.on("error", () => {});
}

fs.appendFileSync(path.join(state, "ready"), `${process.pid} ${Date.now()}\n`);

if (process.stdin.isTTY) process.stdin.setRawMode(true);
process.stdin.resume();
let buf = "";
const seen = new Set();
process.stdin.on("data", (chunk) => {
  buf += chunk.toString("utf8");
  const re = /W(\d+)Z/g;
  let match;
  while ((match = re.exec(buf))) {
    if (seen.has(match[1])) continue;
    seen.add(match[1]);
    fs.appendFileSync(path.join(state, "hits"), `${match[1]} ${Date.now()}\n`);
  }
  if (buf.length > 8000) buf = buf.slice(-500);
});

function markClosed() {
  try {
    fs.appendFileSync(path.join(state, "closed"), `${process.pid} ${Date.now()}\n`);
  } catch {}
  process.exit(0);
}
process.on("SIGHUP", markClosed);
process.on("SIGTERM", markClosed);
setInterval(() => {}, 1 << 30);
